{
  "name": "devguia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Guia em PT-BR de comandos Git, Docker e mais: tutoriais, referência rápida e cheat sheet.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "check:links": "node scripts/checar-links.mjs dist /DevGuia",
    "astro": "astro",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "count": "node scripts/contar-comandos.mjs --min git=60 --min docker=60",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.9",
    "astro": "^7.4.7",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
