---
// Rodapé padrão + cartão "concluí este capítulo" nas páginas de tutorial.
// Também marca com ✓ no menu lateral os capítulos já concluídos.
import Default from '@astrojs/starlight/components/Footer.astro';
import ConcluirCapitulo from '../ConcluirCapitulo.astro';

const id = Astro.locals.starlightRoute.id;
const ehCapitulo = /^[^/]+\/tutorial\/.+/.test(id);
---

{ehCapitulo && <ConcluirCapitulo id={id} />}
<Default />

<script>
  import { EVENTO_PROGRESSO, lerProgresso } from '../../scripts/progresso';

  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const marcar = () => {
    const { capitulos } = lerProgresso();
    for (const link of document.querySelectorAll<HTMLAnchorElement>('.sidebar-content a[href]')) {
      const id = new URL(link.href).pathname.slice(base.length + 1).replace(/\/$/, '');
      link.classList.toggle('dg-concluido', Boolean(capitulos[id]));
    }
  };
  document.addEventListener(EVENTO_PROGRESSO, marcar);
  marcar();
</script>

<style is:global>
  .sidebar-content a.dg-concluido::after {
    content: '✓';
    margin-inline-start: auto;
    padding-inline-start: 0.5rem;
    color: #22c55e;
    font-weight: 700;
  }
  .sidebar-content a.dg-concluido[aria-current='page']::after {
    color: #fff;
  }
  .sidebar-content a.dg-concluido {
    display: flex;
  }
</style>
