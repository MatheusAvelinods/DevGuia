---
// Hero da página inicial: título com gradiente, ações e o terminal animado.
import { Icon } from '@astrojs/starlight/components';
import TerminalAnimado from '../TerminalAnimado.astro';

const {
  title = Astro.locals.starlightRoute.entry.data.title,
  tagline,
  actions = [],
} = Astro.locals.starlightRoute.entry.data.hero ?? {};
---

<div class="hero not-content">
  <div class="texto">
    <p class="selo">
      <span aria-hidden="true">✨</span> Guia prático em português
    </p>
    <h1 id="_top" class="dg-titulo" set:html={title} />
    {tagline && <p class="tagline" set:html={tagline} />}
    <div class="acoes">
      {actions.map(({ text, link, icon, variant }) => (
        <a class:list={['dg-botao', { 'dg-botao--primario': variant !== 'minimal' }]} href={link}>
          {text}
          {icon?.type === 'icon' && <Icon name={icon.name} size="1.1em" />}
        </a>
      ))}
    </div>
    <button type="button" class="busca" data-abrir-busca>
      <Icon name="magnifier" size="1.1em" />
      <span>Procurar um comando…</span>
      <kbd>Ctrl K</kbd>
    </button>
  </div>
  <TerminalAnimado
    ids={[
      'git-switch-c',
      'docker-run-d',
      'git-reset-soft',
      'docker-compose-up',
      'git-log-graph',
      'docker-logs-f',
      'git-stash',
      'docker-system-df',
    ]}
  />
</div>

<script>
  // O botão grande de busca abre a mesma busca do cabeçalho.
  for (const botao of document.querySelectorAll('[data-abrir-busca]')) {
    botao.addEventListener('click', () => {
      document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]')?.click();
    });
  }
</script>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-block: 1.5rem 2.5rem;
  }
  @media (min-width: 56rem) {
    .hero {
      grid-template-columns: 1.05fr 1fr;
      gap: 3.5rem;
      padding-block: 3rem 3.5rem;
    }
  }
  .selo {
    display: inline-flex;
    gap: 0.4rem;
    margin: 0 0 1rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: var(--dg-superficie);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 600;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 4.4rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.045em;
    background: var(--dg-gradiente);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .tagline {
    margin: 1.1rem 0 1.6rem;
    max-width: 34rem;
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    line-height: 1.55;
    color: var(--sl-color-gray-2);
  }
  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .acoes .dg-botao {
    padding: 0.75rem 1.3rem;
    font-size: var(--sl-text-base);
  }
  .busca {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    max-width: 26rem;
    margin-top: 1.4rem;
    padding: 0.75rem 1rem;
    border: 1px dashed var(--sl-color-gray-4);
    border-radius: 0.8rem;
    background: transparent;
    color: var(--sl-color-gray-3);
    font: inherit;
    cursor: pointer;
    transition:
      border-color var(--dg-transicao),
      color var(--dg-transicao),
      background-color var(--dg-transicao);
  }
  .busca:hover {
    border-style: solid;
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
    background: var(--dg-superficie);
  }
  .busca kbd {
    margin-inline-start: auto;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.35rem;
    font-size: var(--sl-text-xs);
    font-family: var(--dg-mono);
  }
</style>
