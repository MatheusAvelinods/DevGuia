---
// Lista todas as categorias de uma tecnologia, com filtros por nível e "só destrutivos".
// Sem JavaScript, tudo aparece; com JS, os filtros ficam visíveis e funcionam.
import type { Categoria, ComandoIndexado } from '../lib/comandos-core';
import { indexarComandos } from '../lib/comandos-core';
import { NIVEIS, ROTULO_NIVEL } from '../lib/schema-comandos';
import CardComando from './CardComando.astro';

interface Props {
  categorias: Categoria[];
}

const { categorias } = Astro.props;
const comandos = indexarComandos(categorias);
const porCategoria = (slug: string) => comandos.filter((c: ComandoIndexado) => c.categoriaSlug === slug);
---

<form class="filtros not-content" data-filtros hidden aria-label="Filtrar comandos">
  <label>
    Nível
    <select name="nivel">
      <option value="">Todos</option>
      {NIVEIS.map((n) => (
        <option value={n}>{ROTULO_NIVEL[n]}</option>
      ))}
    </select>
  </label>
  <label class="check">
    <input type="checkbox" name="destrutivos" />
    Só destrutivos
  </label>
  <output aria-live="polite" data-contagem>
    {comandos.length} comandos
  </output>
</form>

{categorias.map((cat) => (
  <section class="categoria" data-categoria>
    <h2 id={cat.slug}>{cat.categoria}</h2>
    {cat.descricao && <p>{cat.descricao}</p>}
    {porCategoria(cat.slug).map((c) => (
      <CardComando comando={c} />
    ))}
  </section>
))}

<p class="vazio" data-vazio hidden>
  Nenhum comando com esses filtros.
</p>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-filtros]');
  if (form) {
    form.hidden = false;
    const cards = [...document.querySelectorAll<HTMLElement>('.cmd[data-nivel]')];
    const secoes = [...document.querySelectorAll<HTMLElement>('[data-categoria]')];
    const contagem = form.querySelector('[data-contagem]')!;
    const vazio = document.querySelector<HTMLElement>('[data-vazio]')!;

    const aplicar = () => {
      const nivel = (form.elements.namedItem('nivel') as HTMLSelectElement).value;
      const soDestrutivos = (form.elements.namedItem('destrutivos') as HTMLInputElement).checked;
      let visiveis = 0;
      for (const card of cards) {
        const ok =
          (!nivel || card.dataset.nivel === nivel) && (!soDestrutivos || card.dataset.destrutivo === 'sim');
        card.hidden = !ok;
        if (ok) visiveis++;
      }
      for (const secao of secoes) {
        secao.hidden = !secao.querySelector('.cmd:not([hidden])');
      }
      contagem.textContent =
        visiveis === cards.length ? `${cards.length} comandos` : `${visiveis} de ${cards.length} comandos`;
      vazio.hidden = visiveis > 0;
    };

    form.addEventListener('change', aplicar);
    form.addEventListener('submit', (e) => e.preventDefault());
  }
</script>

<style>
  .filtros {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6);
    font-size: var(--sl-text-sm);
  }
  .filtros[hidden] {
    display: none;
  }
  .filtros label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .filtros select {
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.25rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    font: inherit;
  }
  .filtros input {
    width: 1rem;
    height: 1rem;
    accent-color: var(--sl-color-accent);
  }
  .filtros :is(select, input):focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
  .filtros output {
    margin-inline-start: auto;
    color: var(--sl-color-gray-2);
  }
  .categoria[hidden],
  .cmd[hidden] {
    display: none;
  }
  .categoria h2 {
    scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
  }
</style>
