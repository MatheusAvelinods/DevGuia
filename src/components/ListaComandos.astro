---
// Lista todas as categorias de uma tecnologia, com filtros por nível e "só destrutivos".
// Sem JavaScript, tudo aparece; com JS, os filtros ficam visíveis e funcionam.
import type { Categoria, ComandoIndexado } from '../lib/comandos-core';
import { indexarComandos } from '../lib/comandos-core';
import { NIVEIS, ROTULO_NIVEL } from '../lib/schema-comandos';
import CardComando from './CardComando.astro';

interface Props {
  categorias: Categoria[];
}

const { categorias } = Astro.props;
const comandos = indexarComandos(categorias);
const porCategoria = (slug: string) => comandos.filter((c: ComandoIndexado) => c.categoriaSlug === slug);
---

<noscript>
  <style>
    [data-filtros] {
      display: none !important;
    }
  </style>
</noscript>
<form class="filtros not-content" data-filtros aria-label="Filtrar comandos">
  <fieldset class="niveis">
    <legend class="sr-only">Nível</legend>
    <label>
      <input type="radio" name="nivel" value="" checked />
      <span>Todos</span>
    </label>
    {NIVEIS.map((n) => (
      <label>
        <input type="radio" name="nivel" value={n} />
        <span>{ROTULO_NIVEL[n]}</span>
      </label>
    ))}
  </fieldset>
  <label class="perigo">
    <input type="checkbox" name="destrutivos" />
    <span>⚠ Só destrutivos</span>
  </label>
  <output aria-live="polite" data-contagem>
    {comandos.length} comandos
  </output>
</form>

<nav class="atalhos not-content" aria-label="Categorias">
  {categorias.map((cat) => (
    <a href={`#${cat.slug}`} data-atalho={cat.slug}>
      {cat.categoria} <span class="n">{porCategoria(cat.slug).length}</span>
    </a>
  ))}
</nav>

{categorias.map((cat) => (
  <section class="categoria" data-categoria>
    <h2 id={cat.slug}>{cat.categoria}</h2>
    {cat.descricao && <p>{cat.descricao}</p>}
    {porCategoria(cat.slug).map((c) => (
      <CardComando comando={c} />
    ))}
  </section>
))}

<p class="vazio" data-vazio hidden>
  Nenhum comando com esses filtros.
</p>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-filtros]');
  if (form) {
    const cards = [...document.querySelectorAll<HTMLElement>('.cmd[data-nivel]')];
    const secoes = [...document.querySelectorAll<HTMLElement>('[data-categoria]')];
    const contagem = form.querySelector('[data-contagem]')!;
    const vazio = document.querySelector<HTMLElement>('[data-vazio]')!;

    const aplicar = () => {
      const nivel = String(new FormData(form).get('nivel') ?? '');
      const soDestrutivos = (form.elements.namedItem('destrutivos') as HTMLInputElement).checked;
      let visiveis = 0;
      for (const card of cards) {
        const ok =
          (!nivel || card.dataset.nivel === nivel) && (!soDestrutivos || card.dataset.destrutivo === 'sim');
        card.hidden = !ok;
        if (ok) visiveis++;
      }
      for (const secao of secoes) {
        const visivel = secao.querySelectorAll('.cmd:not([hidden])').length;
        secao.hidden = visivel === 0;
        const atalho = document.querySelector<HTMLElement>(
          `[data-atalho="${secao.querySelector('h2')!.id}"]`,
        );
        if (atalho) {
          atalho.hidden = visivel === 0;
          atalho.querySelector('.n')!.textContent = String(visivel);
        }
      }
      contagem.textContent =
        visiveis === cards.length ? `${cards.length} comandos` : `${visiveis} de ${cards.length} comandos`;
      vazio.hidden = visiveis > 0;
    };

    form.addEventListener('change', aplicar);
    form.addEventListener('submit', (e) => e.preventDefault());
  }
</script>

<style>
  .filtros {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--dg-raio);
    background: var(--dg-superficie);
    box-shadow: var(--dg-sombra);
    font-size: var(--sl-text-sm);
  }
  .filtros[hidden] {
    display: none;
  }
  .niveis {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .filtros label {
    position: relative;
  }
  .filtros input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }
  .filtros label span {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: var(--dg-superficie-2);
    color: var(--sl-color-gray-2);
    font-weight: 600;
    transition:
      background-color var(--dg-transicao),
      border-color var(--dg-transicao),
      color var(--dg-transicao);
  }
  .filtros label:hover span {
    border-color: var(--sl-color-accent);
  }
  .filtros input:checked + span {
    border-color: transparent;
    background: var(--sl-color-accent);
    color: #fff;
  }
  .filtros .perigo input:checked + span {
    background: var(--sl-color-red);
    color: #fff;
  }
  :global([data-theme='light']) .filtros .perigo input:checked + span {
    background: #b91c1c;
  }
  .filtros input:focus-visible + span {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
  .filtros output {
    margin-inline-start: auto;
    color: var(--sl-color-gray-3);
    font-weight: 600;
  }
  .atalhos {
    position: sticky;
    top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height, 0rem));
    z-index: 2;
    display: flex;
    gap: 0.4rem;
    margin: 0.8rem calc(-1 * var(--sl-content-pad-x, 0rem)) 0;
    padding: 0.6rem var(--sl-content-pad-x, 0rem);
    overflow-x: auto;
    scrollbar-width: none;
    background: color-mix(in srgb, var(--sl-color-black) 85%, transparent);
    backdrop-filter: blur(10px);
  }
  .atalhos a {
    flex: none;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color var(--dg-transicao),
      color var(--dg-transicao);
  }
  .atalhos a:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
  .atalhos a[hidden] {
    display: none;
  }
  .atalhos .n {
    margin-inline-start: 0.2rem;
    color: var(--sl-color-gray-3);
  }
  .categoria[hidden],
  .cmd[hidden] {
    display: none;
  }
  .categoria h2 {
    scroll-margin-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height, 0rem) + 4rem);
  }
</style>
