{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4321",
      "startServerReadyPattern": "localhost:4321",
      "url": [
        "http://localhost:4321/DevGuia/",
        "http://localhost:4321/DevGuia/git/referencia/",
        "http://localhost:4321/DevGuia/git/tutorial/desfazendo-coisas/",
        "http://localhost:4321/DevGuia/docker/referencia/",
        "http://localhost:4321/DevGuia/docker/tutorial/docker-compose/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
